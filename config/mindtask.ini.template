[shortcuts]
open_tasks = Ctrl+1
open_settings = Ctrl+2
open_projects = Ctrl+P
new_task = Ctrl+N
focus_search = Ctrl+F
escape_tasks = Esc
refresh = F5
history = Ctrl+H
