[database]
path = data/mindtask.db

[ui]
theme = system
language = en
smart_task_sorting = true
hide_completed_tasks = false

[ai]
base_url =
api_key =
default_model =
models = []
models_endpoint =
request_timeout_seconds = 30
allow_database_write = false
